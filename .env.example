# Copy to .env and fill in what you need. Everything here is optional for local
# development: with no .env at all the app runs on SQLite with no integrations.

# ---- database ----
# Leave unset for SQLite (./backend/playnext.db).
# Docker Compose and production use Postgres:
# DATABASE_URL=postgresql+psycopg://playnext:playnext@db:5432/playnext
POSTGRES_USER=playnext
POSTGRES_PASSWORD=playnext
POSTGRES_DB=playnext

# ---- security ----
# MUST be changed before deploying anywhere public. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Login/registration attempts per IP
LOGIN_RATE_LIMIT=10/minute

# ---- optional integrations ----
# IGDB (free, via a Twitch developer app): every platform's catalogue in Browse.
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key: "Sign in with Steam" library import.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ---- email ----
# "console" (default) logs verification and reset links to the terminal, which
# is all local development needs. Set to "smtp" and fill in the rest to send
# real mail. Any provider works; these are the common ones:
#   Resend    smtp.resend.com    port 587   user "resend"     password = API key
#   Brevo     smtp-relay.brevo.com  port 587  user = login    password = SMTP key
#   Gmail     smtp.gmail.com     port 587   user = address    password = app password
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PlayNext <no-reply@yourdomain.com>
# Block sign-in until the address is confirmed. Leave false unless mail works.
REQUIRE_EMAIL_VERIFICATION=false

# ---- deployment URLs ----
# Needed for the Steam sign-in round trip once deployed.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
